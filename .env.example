# CleanTech Open 2025 Diligence Engine - Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual credentials.

# Supabase Database Connection (PostgreSQL Direct / Pooler)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:your_db_password@your_supabase_host:6543/postgres

# Supabase API Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Local Development Server Port
PORT=3000
