  "body_html": "<div class=\"captioned-image-container\"><figure><a class=\"image-link image2\" target=\"_blank\" href=\"https://substackcdn.com/image/fetch/$s_!M6Fj!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1b2d97bd-96b4-4984-bfb3-e968948457ca_1346x325.webp\" data-component-name=\"Image2ToDOM\"><div class=\"image2-inset\"><picture><source type=\"image/webp\" srcset=\"https://substackcdn.com/image/fetch/$s_!M6Fj!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1b2d97bd-96b4-4984-bfb3-e968948457ca_1346x325.webp 424w, https://substackcdn.com/image/fetch/$s_!M6Fj!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1b2d97bd-96b4-4984-bfb3-e968948457ca_1346x325.webp 848w, https://substackcdn.com/image/fetch/$s_!M6Fj!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1b2d97bd-96b4-4984-bfb3-e968948457ca_1346x325.webp 1272w, https://substackcdn.com/image/fetch/$s_!M6Fj!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1b2d97bd-96b4-4984-bfb3-e968948457ca_1346x325.webp 1456w\" sizes=\"100vw\"><img src=\"https://substackcdn.com/image/fetch/$s_!M6Fj!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1b2d97bd-96b4-4984-bfb3-e968948457ca_1346x325.webp\" width=\"1346\" height=\"325\" data-attrs=\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/1b2d97bd-96b4-4984-bfb3-e968948457ca_1346x325.webp&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:325,&quot;width&quot;:1346,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:17372,&quot;alt&quot;:null,&